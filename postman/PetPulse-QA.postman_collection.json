    {
      "name": "04 - Limpeza dos dados de teste",
      "description": "Remove os registros criados para que a coleção possa ser executada novamente com os mesmos dados controlados.",
      "item": [
        {
          "name": "Limpeza - remover pet de teste e dependências",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tutor_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pets/{{pet_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pets",
                "{{pet_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Remove alertas, leituras e históricos; depois o dispositivo. O pet é removido pela própria request.",
                  "const base = pm.environment.get(\"base_url\");",
                  "const auth = { key: \"Authorization\", value: \"Bearer \" + pm.collectionVariables.get(\"tutor_token\") };",
                  "const ids = JSON.parse(pm.collectionVariables.get(\"cleanup\") || '{\"alerts\":[],\"readings\":[],\"histories\":[]}');",
                  "const queue = []",
                  "    .concat(ids.alerts.map(id => \"/smart-alerts/\" + id))",
                  "    .concat(ids.readings.map(id => \"/iot-readings/\" + id))",
                  "    .concat(ids.histories.map(id => \"/clinical-histories/\" + id));",
                  "if (pm.collectionVariables.get(\"device_id\")) queue.push(\"/iot-devices/\" + pm.collectionVariables.get(\"device_id\"));",
                  "(function next() {",
                  "    const path = queue.shift();",
                  "    if (!path) return;",
                  "    pm.sendRequest({ url: base + path, method: \"DELETE\", header: [auth] }, (err, res) => {",
                  "        console.log(\"DELETE \" + path + \" -> \" + (err ? err : res.code));",
                  "        next();",
                  "    });",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set(\"pet_id\", \"\");",
                  "pm.collectionVariables.set(\"device_id\", \"\");",
                  "pm.collectionVariables.set(\"cleanup\", \"\");"
                ]
              }
            }
          ]
        }
      ]
    }
