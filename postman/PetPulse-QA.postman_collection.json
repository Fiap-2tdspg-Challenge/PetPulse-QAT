        {
          "name": "CT01 - Login tutor (credenciais válidas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tutor_email}}\",\n  \"password\": \"{{tutor_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"Token JWT retornado\", () => pm.expect(token).to.match(/^eyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "const payload = JSON.parse(atob(token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "pm.test(\"Claim role = ROLE_TUTOR\", () => pm.expect(payload.role).to.eql(\"ROLE_TUTOR\"));",
                  "pm.test(\"Subject = e-mail do tutor\", () => pm.expect(payload.sub).to.eql(pm.environment.get(\"tutor_email\")));",
                  "pm.test(\"Expiração de 20 minutos\", () => pm.expect(payload.exp - payload.iat).to.eql(1200));",
                  "pm.collectionVariables.set(\"tutor_token\", token);"
                ]
              }
            }
          ]
        },
