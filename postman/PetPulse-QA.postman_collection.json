    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Requisito de desempenho aplicado a todas as requisições",
          "pm.test(\"[Desempenho] tempo de resposta abaixo de \" + pm.environment.get(\"max_response_ms\") + \" ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"max_response_ms\")));",
          "});"
        ]
      }
    }
  ],
